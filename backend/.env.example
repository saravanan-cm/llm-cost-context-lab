APP_NAME="LLM Cost & Context Lab"
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:5173"]

# LLM: "openai" (default) or "mock" (offline, no API key needed)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1024

# Database (SQLite locally; e.g. postgresql+psycopg://user:pass@host/db later)
DATABASE_URL=sqlite:///./app.db
DB_AUTO_MIGRATE=true

# Credits: credits consumed = LLM cost in USD * CREDITS_PER_DOLLAR
CREDITS_PER_DOLLAR=1000
DEV_USER_ID=dev-user
DEV_USER_INITIAL_CREDITS=1000

# Knowledge base: embeddings + vector store (used by the API and the ingestion CLI)
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional reduced dimension for text-embedding-3-* (leave empty for the native size)
OPENAI_EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=100
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=interview_knowledge

# Ingestion (read by ingestion/ only)
WIKIPEDIA_LANGUAGE=en
# Comma-separated titles; leave empty to use ingestion/articles.txt
WIKIPEDIA_ARTICLES=
# Wikimedia asks for a contact in the User-Agent, e.g. "MyApp/1.0 (you@example.com)"
WIKIPEDIA_USER_AGENT=LLMCostContextLab/0.3 (educational portfolio project)
# Characters per chunk / overlap between consecutive chunks
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# RAG (chat answers grounded in the knowledge base)
RAG_ENABLED=true
RAG_TOP_K=5
# Cosine-similarity cut-off for text-embedding-3-small; blank = no filtering
RAG_MIN_RELEVANCE_SCORE=0.30
# fixed_response: reply without calling the LLM when nothing relevant is found | llm: let the LLM answer, flagged as ungrounded
RAG_NO_CONTEXT_MODE=fixed_response
# Include retrieved chunks + scores in chat responses (development only)
RAG_DEBUG=false
